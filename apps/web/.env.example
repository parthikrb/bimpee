# Copy to .env.local. Everything is optional: without these the game runs in
# guest mode and talks to the worker through the Vite dev proxy (/api, /parties).

# Supabase (anonymous sign-in, display names, "save progress across devices").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the worker lives when it is NOT same-origin (production split deploys).
# e.g. https://bimpee-worker.example.workers.dev  (no trailing slash)
VITE_API_BASE=
# Host for multiplayer rooms (PartyKit/partyserver). Defaults to the API host or location.host.
VITE_PARTY_HOST=
